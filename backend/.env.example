# 应用配置
APP_NAME="视频水印去除工具"
APP_VERSION="1.0.0"
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 文件存储路径
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
THUMBNAIL_DIR=thumbnails

# 文件大小限制（字节）
MAX_FILE_SIZE=5368709120  # 5GB

# 批量处理限制
MAX_BATCH_UPLOAD=50
MAX_PARALLEL_UPLOAD=5
MAX_PARALLEL_PROCESS=3

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./video_watermark.db

# 支持的视频格式
SUPPORTED_FORMATS=mp4,avi,mov,mkv
