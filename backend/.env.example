# ============================================
# 应用配置
# ============================================

# 应用名称
APP_NAME="一键美"

# 应用版本
APP_VERSION="1.0.0"

# 调试模式（生产环境设置为false）
# 开启后会显示详细错误信息和自动重载
DEBUG=true

# ============================================
# 服务器配置
# ============================================

# 服务器监听地址
# 0.0.0.0 表示监听所有网络接口
# 127.0.0.1 表示仅监听本地
HOST=0.0.0.0

# 服务器监听端口
PORT=8000

# ============================================
# 文件存储配置
# ============================================

# 上传视频存储目录
UPLOAD_DIR=uploads

# 处理后视频输出目录
OUTPUT_DIR=outputs

# 视频缩略图存储目录
THUMBNAIL_DIR=thumbnails

# 单个文件最大大小（字节）
# 默认: 5368709120 (5GB)
MAX_FILE_SIZE=5368709120

# ============================================
# 批量处理配置
# ============================================

# 批量上传最大文件数量
MAX_BATCH_UPLOAD=50

# 并行上传最大数量
# 同时上传的文件数量限制
MAX_PARALLEL_UPLOAD=5

# 并行处理最大数量
# 同时处理视频的数量限制
MAX_PARALLEL_PROCESS=3

# ============================================
# 数据库配置
# ============================================

# 数据库连接URL
# SQLite示例: sqlite+aiosqlite:///./video_platform.db
# PostgreSQL示例: postgresql+asyncpg://user:password@localhost/dbname
DATABASE_URL=sqlite+aiosqlite:///./video_platform.db

# ============================================
# 视频格式配置
# ============================================

# 支持的视频格式（逗号分隔）
SUPPORTED_FORMATS=mp4,avi,mov,mkv

# ============================================
# 安全配置（可选）
# ============================================

# CORS允许的源（逗号分隔）
# 生产环境应设置为具体的前端域名
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# API密钥（可选，用于API认证）
# API_KEY=your-secret-api-key

# ============================================
# 性能配置（可选）
# ============================================

# 缓存过期时间（秒）
# CACHE_EXPIRE_TIME=3600

# 任务队列最大大小
# TASK_QUEUE_MAX_SIZE=100

# ============================================
# 日志配置（可选）
# ============================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# 日志文件路径
# LOG_FILE=logs/app.log
