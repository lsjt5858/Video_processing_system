# ============================================
# 生产环境配置模板
# ============================================
# 
# 使用说明:
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置值
# 3. 确保敏感信息不被提交到版本控制
#

# ============================================
# 应用配置
# ============================================

APP_NAME="视频水印去除工具"
APP_VERSION="1.0.0"

# 生产环境必须关闭调试模式
DEBUG=false

# ============================================
# 服务器配置
# ============================================

# 监听所有网络接口
HOST=0.0.0.0

# 服务端口
PORT=8000

# ============================================
# 文件存储配置
# ============================================

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
THUMBNAIL_DIR=thumbnails

# 5GB文件大小限制
MAX_FILE_SIZE=5368709120

# ============================================
# 批量处理配置
# ============================================

# 根据服务器性能调整
MAX_BATCH_UPLOAD=50
MAX_PARALLEL_UPLOAD=5
MAX_PARALLEL_PROCESS=3

# ============================================
# 数据库配置
# ============================================

# SQLite（适合小规模部署）
DATABASE_URL=sqlite+aiosqlite:///./video_platform.db

# PostgreSQL（推荐用于生产环境）
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/video_platform

# ============================================
# 视频格式配置
# ============================================

SUPPORTED_FORMATS=mp4,avi,mov,mkv

# ============================================
# 安全配置
# ============================================

# CORS配置（设置为前端域名）
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# API密钥（用于API认证）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY

# JWT密钥（如果使用JWT认证）
# JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY

# ============================================
# 性能配置
# ============================================

# 缓存过期时间（秒）
CACHE_EXPIRE_TIME=3600

# 任务队列最大大小
TASK_QUEUE_MAX_SIZE=100

# Worker进程数（建议设置为CPU核心数）
WORKERS=4

# ============================================
# 日志配置
# ============================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# ============================================
# 监控配置（可选）
# ============================================

# Sentry DSN（错误追踪）
# SENTRY_DSN=https://your-sentry-dsn

# Prometheus监控端口
# PROMETHEUS_PORT=9090

# ============================================
# 外部服务配置（可选）
# ============================================

# Redis配置（用于缓存和任务队列）
# REDIS_URL=redis://localhost:6379/0

# S3/MinIO配置（用于对象存储）
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=video-platform

# ============================================
# 邮件配置（可选，用于通知）
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@yourdomain.com

# ============================================
# 备份配置（可选）
# ============================================

# 自动备份启用
# BACKUP_ENABLED=true

# 备份目录
# BACKUP_DIR=/backup

# 备份保留天数
# BACKUP_RETENTION_DAYS=30
